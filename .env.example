# Configuracion local de MySQL. La base se define en Bd/scriptbd.sql.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatbot_siagie_db
DB_USER=root
DB_PASSWORD=CAMBIAR_POR_TU_PASSWORD_MYSQL

# Clave para firmar las sesiones Flask; mantener privada y estable.
SECRET_KEY=GENERAR_UNA_CLAVE_ALEATORIA_PRIVADA

# Servidor local al ejecutar python app.py.
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=true

# Si Tesseract esta en PATH, dejar vacio.
# Si no, indicar la ruta real, por ejemplo:
# TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"
TESSERACT_PATH=
